# ---------- 依赖 ----------
node_modules/

# ---------- 构建中间产物 ----------
build/

# ---------- 桌面 APP 打包产物 ----------
# 每个目录约 266MB，其中 StarStrike.exe 单文件 177MB，
# 超过 GitHub 100MB 单文件硬上限，一律不入库。
# 需要分发包请走 GitHub Releases。
dist-app*/
release/

# ---------- 单文件网页版 ----------
# dist/starstrike.html 是本项目的主交付物（约 640KB，双击即玩），保留入库；
# 其余构建残留一律忽略。
/dist/*
!/dist/starstrike.html

# ---------- 验收脚本的临时产物 ----------
.verify*/
.browser-profile/
.chrome-profile/
.tmpcheck/
.tmp-probe/
.tmp-*.mjs

# ---------- 系统 ----------
Thumbs.db
.DS_Store
*.log
